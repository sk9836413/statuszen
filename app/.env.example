# ─────────────────────────────────────────────────────────────────────────────
# Statuszen environment variables
#
# You do NOT need this file for a normal installation: open your site in the
# browser and the web installer writes everything to storage/config.json.
#
# Use these variables only for Docker, read-only hosting or advanced setups.
# Copy this file to `.env.local` (or set the variables in your hosting panel).
# ─────────────────────────────────────────────────────────────────────────────

# Port the server listens on (server.js / npm start)
PORT=3000

# Public address of the platform, used when "Site URL" is empty in the admin panel.
# Alert links, heartbeat ping URLs, badge/widget snippets and status page links in emails
# are built from it, so use your final https:// address.
# SITE_URL=https://uptime.example.com

# Where config.json, the SQLite database and uploads (logos, status page logos) are stored.
# STORAGE_DIR=/var/lib/statuszen

# Number of reverse proxies in front of the app that add X-Forwarded-For. Used to find
# the real visitor IP for rate limits (sign-in, registration, status page subscriptions, cron URL).
# Default 1: Nginx, Apache/Passenger (cPanel) or Vercel. Use 2 for Cloudflare in front of Nginx.
# TRUSTED_PROXY_HOPS=1

# Database — overrides storage/config.json when set.
# Either one connection URL (cloud providers give you this)…
# DATABASE_URL=mysql://user:password@host:3306/statuszen?ssl=true
# …or separate values:
# DB_DRIVER=mysql            # mysql or sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=statuszen
# DB_USER=statuszen
# DB_PASSWORD=secret
# DB_SSL=true                # required by TiDB Cloud, Aiven, DigitalOcean and most cloud MySQL
# DB_FILE=database.sqlite    # SQLite only, relative to STORAGE_DIR

# Create (or promote) an administrator without the web installer.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Administrator

# Fill an empty database with sample users, payments and messages, plus monitors with 90 days
# of history, incidents, a maintenance window and a public status page (/s/demo) for the
# administrator (for a live demo). Runs once per database. Needs ADMIN_EMAIL/ADMIN_PASSWORD.
# DEMO_SEED=true

# Skip the web installer when the database is configured with the variables above
# (e.g. Vercel). Tables are created automatically; use ADMIN_* for the first administrator.
# APP_INSTALLED=true

# Keep Server Action ids stable across multiple servers / rebuilds (optional).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Demo mode: the admin panel and the customer dashboard are read-only. Use this for a
# public live demo.
# DEMO_MODE=true

# Secret for the check scheduler URL /api/cron/tick and for `npm run worker`.
# Without it, one is generated, stored in the database and shown in Admin → System → Scheduler.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# ecosystem.config.cjs and docker-compose.yml fall back to a public placeholder when this is
# not set in their environment, so always set your own long random value there.
# CRON_SECRET=a-long-random-string

# Worker only (npm run worker): address of the app (default SITE_URL, else
# http://localhost:$PORT) and seconds between ticks (default 15, minimum 5).
# WORKER_URL=http://localhost:3000
# WORKER_INTERVAL_SEC=15
